# Managed by Ansible: native VPN optimization
# profile={{ optimization_profile }} tier={{ optimization_tier_name }}

# Congestion control and queueing
net.core.default_qdisc = {{ optimization_default_qdisc }}
net.ipv4.tcp_congestion_control = {{ optimization_congestion_control }}

# Connection accept path
net.core.somaxconn = {{ optimization_somaxconn }}
net.ipv4.tcp_max_syn_backlog = {{ optimization_tcp_max_syn_backlog }}
net.core.netdev_max_backlog = {{ optimization_netdev_backlog }}
net.ipv4.tcp_syncookies = 1

# TCP path and timers
net.ipv4.ip_local_port_range = 10240 65535
{% if optimization_reserved_ports_value | length > 0 %}
net.ipv4.ip_local_reserved_ports = {{ optimization_reserved_ports_value }}
{% endif %}
net.ipv4.tcp_fin_timeout = 30
net.ipv4.tcp_keepalive_time = 300
net.ipv4.tcp_keepalive_intvl = 60
net.ipv4.tcp_keepalive_probes = 5
net.ipv4.tcp_slow_start_after_idle = 0
net.ipv4.tcp_mtu_probing = 1
{% if optimization_live_sysctl["net.ipv4.tcp_min_snd_mss"] | int > 0 %}
net.ipv4.tcp_min_snd_mss = {{ optimization_tcp_min_snd_mss }}
{% endif %}

# Socket buffers: ceilings only; current higher kernel values are preserved
net.core.rmem_max = {{ optimization_rmem_max }}
net.core.wmem_max = {{ optimization_wmem_max }}
net.core.rmem_default = {{ optimization_rmem_default }}
net.core.wmem_default = {{ optimization_wmem_default }}
net.ipv4.tcp_rmem = {{ optimization_tcp_rmem | join(" ") }}
net.ipv4.tcp_wmem = {{ optimization_tcp_wmem | join(" ") }}
net.core.optmem_max = {{ optimization_optmem_max }}

# System capacity: never lower an already higher kernel value
fs.file-max = {{ optimization_file_max }}
fs.nr_open = {{ optimization_nr_open }}
vm.max_map_count = {{ optimization_max_map_count }}
vm.swappiness = {{ optimization_swappiness }}

{% if (optimization_expected_users | int) > 0 %}
# Bound TCP memory only when an explicit user-capacity model was requested.
net.ipv4.tcp_mem = {{ (ansible_facts["memtotal_mb"] | int) * 256 * 10 // 100 }} {{ (ansible_facts["memtotal_mb"] | int) * 256 * 13 // 100 }} {{ (ansible_facts["memtotal_mb"] | int) * 256 * 16 // 100 }}
{% endif %}

# VPN routing, conntrack and path hardening
net.ipv4.ip_forward = 1
net.netfilter.nf_conntrack_max = {{ optimization_conntrack_max }}
net.netfilter.nf_conntrack_buckets = {{ optimization_conntrack_buckets }}
net.netfilter.nf_conntrack_tcp_timeout_established = 3600
net.netfilter.nf_conntrack_tcp_timeout_time_wait = 60
net.netfilter.nf_conntrack_tcp_timeout_close_wait = 30
net.netfilter.nf_conntrack_generic_timeout = 300
net.ipv4.conf.all.rp_filter = 2
net.ipv4.conf.default.rp_filter = 2
net.ipv4.conf.all.accept_redirects = 0
net.ipv4.conf.default.accept_redirects = 0
net.ipv4.conf.all.send_redirects = 0
net.ipv4.conf.default.send_redirects = 0
net.ipv4.conf.all.accept_source_route = 0
net.ipv4.conf.default.accept_source_route = 0
net.ipv4.icmp_echo_ignore_broadcasts = 1
net.ipv4.icmp_ignore_bogus_error_responses = 1
